{
  "name": "json-schema-playground",
  "version": "2.0.0",
  "description": "Visual builder for JSON Schema (draft 2020-12) forms with RJSF-compatible UI Schema, live validated preview, templates, import/export and shareable links.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && echo '' > out/.nojekyll && echo 'json-schema-playground.jonymusky.com' > out/CNAME",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@tailwindcss/forms": "^0.5.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19"
  },
  "author": "Jonathan Muszkat <https://me.jonymusky.com>",
  "engines": {
    "node": ">=20.9"
  }
}
